# Copy to .env.local for development, and set the same keys in the hosting
# provider's environment for a deployment. Values here are examples, not real.

# Resend API key.
#
# Used by the contact form and by the spec sheet's "Submit my build".
#
# The contact form is on /contact either way. Without this the form still
# renders and still validates, but the send is refused: the visitor is told to
# email us directly, keeps what they typed, and the server logs
# "[email] RESEND_API_KEY is not set". Set the key and redeploy and it sends —
# there is no code change to make.
#
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The address mail is sent *from*, which Resend will only accept on a
# domain verified in the same account — so until originguitars.com is verified
# there, point this at a sender that is.
#
# Defaults to "Origin Guitars <hello@originguitars.com>" when unset.
# Deliberately not the visitor's own address: sending as them is what gets a
# domain flagged by SPF and DMARC. Their address goes in Reply-To instead.
RESEND_FROM_EMAIL="Origin Guitars <hello@originguitars.com>"

# Optional. Where submitted builds from /spec-sheet go: this inbox is copied
# into the customer's confirmation email, and replies come back to it.
# Defaults to hello@originguitars.com when unset.
SPEC_SHEET_ORDERS_EMAIL="orders@originguitars.com"

# Optional. The site's public address, used for the logo in emails (an email
# cannot load a relative URL). Unset, it falls back to the production domain
# Vercel provides, then to https://originguitars.vercel.app.
SITE_URL="https://originguitars.com"
